---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import GameCover from './GameCover.astro';
import type { Game } from '../lib/games';
import { excerpt } from '../lib/text';
import { OS_LABEL, PLATFORM_LABEL, platformOf } from '../lib/compat';

interface Props {
  game: Game;
  entry: CollectionEntry<'compat'>;
}
const { game, entry } = Astro.props;
const d = entry.data;
const summary = excerpt(entry.body ?? '');
const platform = platformOf(d.titleId);
const date = d.testedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<a href={`/game/${game.titleId}/?os=${d.os}`} class="card card-link group flex gap-4 p-4 sm:gap-5 sm:p-5">
  <GameCover
    game={game}
    size={88}
    class="rounded-xl shadow-[0_6px_18px_rgba(14,30,60,0.2)] ring-1 ring-black/10 dark:ring-white/10"
  />
  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-3">
      <p class="line-clamp-2 font-display text-[15px] leading-snug font-bold transition-colors group-hover:text-accent">
        {game.name}
      </p>
      <StatusBadge status={d.status} />
    </div>
    <p class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
      {platform === 'ps4' && (
        <span class="rounded-md border border-line px-1.5 py-px font-mono text-[10px] font-semibold text-ink/80">
          {PLATFORM_LABEL[platform]}
        </span>
      )}
      <span>{OS_LABEL[d.os]}</span>
      <span aria-hidden="true">·</span>
      <span>{date}</span>
      <span aria-hidden="true">·</span>
      <span class="max-w-[11rem] truncate font-mono text-[11px]" title={d.testedVersion}>{d.testedVersion}</span>
      {d.legacyBuild && (
        <span class="rounded-full border border-line px-1.5 py-px text-[10px] tracking-wide uppercase">legacy</span>
      )}
    </p>
    {summary && <p class="mt-2.5 line-clamp-2 text-[13px] leading-relaxed text-muted">{summary}</p>}
  </div>
</a>
