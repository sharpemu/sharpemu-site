---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Giscus from '../../components/Giscus.astro';
import OsTabs from '../../components/OsTabs.astro';
import GameCover from '../../components/GameCover.astro';
import { games, gameByAnyTitleId, gameByTitleId, hasGamePage } from '../../lib/games';
import { DEFAULT_OS, OSES, OS_LABEL, PLATFORM_LABEL, type DisplayStatus, type Os } from '../../lib/compat';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const reported = new Set(
    (await getCollection('compat')).map((e) => gameByAnyTitleId.get(e.data.titleId)?.titleId),
  );
  return games
    .filter((g) => hasGamePage(g, reported.has(g.titleId)))
    .map((g) => ({ params: { titleId: g.titleId } }));
}

const { titleId } = Astro.params;
const game = gameByTitleId.get(titleId)!;
const listHref = game.platform === 'ps5' ? '/compatibility' : `/compatibility/${game.platform}`;
// Reports may reference any regional release of this game.
const reports = await getCollection('compat', (e) => game.allTitleIds.includes(e.data.titleId));
// One report per OS (enforced by the games index build), rendered as one tab panel each.
const byOs = Object.fromEntries(
  await Promise.all(
    OSES.map(async (os) => {
      const report = reports.find((e) => e.data.os === os);
      return [os, report && { report, Content: (await render(report)).Content }] as const;
    }),
  ),
);
const dots = Object.fromEntries(OSES.map((os) => [os, byOs[os]?.report.data.status ?? 'untested'])) as Record<
  Os,
  DisplayStatus
>;
const CTA: Record<Os, { text: string; button: string }> = {
  windows: {
    text: `Tested ${game.name} on Windows? Add a Windows report with your SharpEmu log attached.`,
    button: 'Submit Windows report',
  },
  linux: {
    text: `Tested ${game.name} on Linux? Add a Linux report and include your Mesa or driver version.`,
    button: 'Submit Linux report',
  },
  macos: {
    text: `Tested ${game.name} on a Mac? macOS reports target the sharpemu-mac Metal build.`,
    button: 'Submit macOS report',
  },
};
const otherIds = game.allTitleIds.filter((id) => id !== game.titleId);
const fmt = (d: string | Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title={`${game.name}${game.platform === 'ps4' ? ' (PS4)' : ''} — ${SITE.name} compatibility`}>
  <article class="mx-auto max-w-6xl px-5 pt-10 md:pt-12" data-pagefind-body={reports.length > 0 ? '' : undefined}>
    <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted">
      <a href={listHref} class="transition-colors hover:text-ink">{PLATFORM_LABEL[game.platform]} compatibility</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span aria-current="page">{game.titleId}</span>
    </nav>

    <!-- Hero -->
    <div class="mt-7 flex flex-col gap-7 md:mt-8 md:flex-row md:gap-10">
      <GameCover
        game={game}
        size={256}
        eager
        class="!h-40 !w-40 rounded-3xl shadow-[0_18px_44px_rgba(14,30,60,0.28)] ring-1 ring-black/10 md:!h-64 md:!w-64 dark:ring-white/10"
      />
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-md bg-accent/12 px-2 py-0.5 font-mono text-[11px] font-semibold tracking-wide text-accent">
            {PLATFORM_LABEL[game.platform]}
          </span>{' '}
          {
            game.genres?.slice(0, 2).map((g) => (
              <span class="rounded-md border border-line px-2 py-0.5 text-[11px] font-medium text-muted">{g}</span>
            ))
          }
        </div>
        <h1 class="mt-3 font-display text-3xl leading-tight font-extrabold tracking-tight break-words text-balance md:text-5xl md:leading-[1.08]">
          {game.name}
        </h1>

        <!-- Status for the selected OS (follows the tabs below) -->
        {
          OSES.map((os) => (
            <p
              class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-base font-medium"
              data-os-group="report"
              data-os-panel={os}
              hidden={os !== DEFAULT_OS}
            >
              <StatusBadge status={dots[os]} size="lg" />{' '}
              <span class="text-muted">on {OS_LABEL[os]}</span>{' '}
              {byOs[os] && (
                <span class="font-mono text-xs text-muted">
                  · SharpEmu {byOs[os]!.report.data.testedVersion}
                </span>
              )}
            </p>
          ))
        }

        <dl class="mt-7 grid grid-cols-[auto_1fr] gap-x-8 gap-y-3 border-t border-line pt-6 text-sm">
          <dt class="text-muted">Title ID</dt>
          <dd>
            {
              otherIds.length > 0 ? (
                <details class="group">
                  <summary class="flex cursor-pointer list-none flex-wrap items-center gap-2 rounded-md [&::-webkit-details-marker]:hidden">
                    <span class="font-mono text-[13px]">{game.titleId}</span>
                    <span class="inline-flex items-center gap-1 rounded-full border border-line px-2.5 py-0.5 text-xs font-medium text-muted transition-colors group-open:text-ink hover:text-ink">
                      +{otherIds.length} more
                      <svg class="h-3 w-3 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </span>
                  </summary>
                  <p class="mt-3 mb-1.5 text-xs text-muted">Other regional releases</p>
                  <ul class="flex max-h-36 flex-wrap gap-1.5 overflow-y-auto pr-1">
                    {otherIds.map((id) => (
                      <li class="rounded-md bg-line px-2 py-0.5 font-mono text-[12px]">{id}</li>
                    ))}
                  </ul>
                </details>
              ) : (
                <span class="font-mono text-[13px]">{game.titleId}</span>
              )
            }
          </dd>
          {game.publisher && <dt class="text-muted">Publisher</dt>}
          {game.publisher && <dd>{game.publisher}</dd>}
          {game.releaseDate && <dt class="text-muted">Released</dt>}
          {game.releaseDate && <dd>{fmt(game.releaseDate)}</dd>}
          {
            game.genres && game.genres.length > 0 && (
              <>
                <dt class="text-muted">Genre</dt>
                <dd>{game.genres.join(', ')}</dd>
              </>
            )
          }
        </dl>
      </div>
    </div>

    <section class="mt-16">
      <h2 class="font-display text-2xl font-bold tracking-tight">Compatibility report</h2>
      <div class="mt-5"><OsTabs group="report" dots={dots} /></div>
      {
        OSES.map((os) => {
          const found = byOs[os];
          const d = found?.report.data;
          const older = d && SITE.currentVersion[os] && d.testedVersion !== SITE.currentVersion[os];
          return (
            <div
              id={`report-${os}`}
              role="tabpanel"
              aria-labelledby={`report-tab-${os}`}
              data-os-group="report"
              data-os-panel={os}
              hidden={os !== DEFAULT_OS}
              class="mt-5"
            >
              {d && found ? (
                <>
                  <div class="card p-6 sm:p-7">
                    <p class="text-xs text-muted">Tested {fmt(d.testedDate)}</p>
                    <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-4 border-y border-line py-5 text-sm sm:grid-cols-4">
                      <div>
                        <dt class="text-xs text-muted">SharpEmu build</dt>
                        <dd class="mt-1.5 font-mono text-[13px] font-semibold break-words">{d.testedVersion}</dd>
                      </div>
                      {d.gameVersion && (
                        <div>
                          <dt class="text-xs text-muted">Game version</dt>
                          <dd class="mt-1.5 font-mono text-[13px] break-words">{d.gameVersion}</dd>
                        </div>
                      )}
                      <div>
                        <dt class="text-xs text-muted">System</dt>
                        <dd class="mt-1.5">{OS_LABEL[d.os]}</dd>
                      </div>
                      {d.hardware && (
                        <div class="col-span-2">
                          <dt class="text-xs text-muted">Hardware</dt>
                          <dd class="mt-1.5 break-words">{d.hardware}</dd>
                        </div>
                      )}
                    </dl>
                    {older && (
                      <p class="badge badge-menus notice mt-5 px-4 py-2 text-sm">
                        This report was made on an older build — behavior may have changed since.
                      </p>
                    )}
                    {d.legacyBuild && (
                      <p class="badge badge-menus notice mt-3 px-4 py-2 text-sm">
                        <strong>Legacy build.</strong> Tested on the Mac build from the main repo, before macOS moved to{' '}
                        <a href={SITE.macRepoUrl} class="underline">sharpemu-mac</a>. Results may not carry over.
                      </p>
                    )}
                    <div class="prose prose-slate dark:prose-invert mt-5 max-w-none">
                      <found.Content />
                    </div>
                  </div>
                  <div
                    class="mt-4 flex flex-col gap-3 px-1 sm:flex-row sm:items-center sm:justify-between"
                    data-pagefind-ignore
                  >
                    <p class="text-sm text-muted">{CTA[os].text}</p>
                    <a href="/compatibility/report" class="btn btn-secondary shrink-0">
                      {CTA[os].button}
                    </a>
                  </div>
                </>
              ) : (
                <div class="card p-6 sm:p-7" data-pagefind-ignore>
                  <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                    <div class="max-w-xl">
                      <p class="font-display text-lg font-bold tracking-tight">No {OS_LABEL[os]} report yet</p>
                      <p class="mt-2 text-sm leading-relaxed text-muted">{CTA[os].text}</p>
                    </div>
                    <a href="/compatibility/report" class="btn btn-primary shrink-0">
                      {CTA[os].button}
                    </a>
                  </div>
                </div>
              )}
            </div>
          );
        })
      }
    </section>

    {
      !game.commentsDisabled && !reports.some((r) => r.data.commentsDisabled) && (
        <section class="mt-16 pb-4" data-pagefind-ignore>
          <h2 class="font-display text-2xl font-bold tracking-tight">Comments</h2>
          <div class="mt-5">
            <Giscus term={game.titleId} />
          </div>
        </section>
      )
    }
  </article>
</Base>
